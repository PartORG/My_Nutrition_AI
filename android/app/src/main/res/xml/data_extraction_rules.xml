<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same include-only list as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="profiles.db" />
        <include domain="file" path="profiles/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="profiles.db" />
        <include domain="file" path="profiles/" />
    </device-transfer>
</data-extraction-rules>
